# Unity generated folders (regenerated on open, never commit)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider project files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
.vs/
.idea/
.vsconfig

# Build outputs
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties

# OS noise
.DS_Store
Thumbs.db

# SECRETS — never commit your API keys
Assets/Resources/ai_config.json
*.env
secrets.json

# Local tooling installers (too large for GitHub)
Assets/Sprites/latest gen/removebg-for-windows-2.4.1.exe
Assets/Sprites/latest gen/removebg-for-windows-2.4.1.exe.meta
